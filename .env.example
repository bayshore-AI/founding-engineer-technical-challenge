# Required: OpenAI API key for LLM calls (provided separately)
OPENAI_API_KEY=sk-your-key-here

# Optional: Override the default OpenAI model
# OPENAI_MODEL=gpt-4o

# Simulated "today": only feed items dated on or before this day have arrived.
# Move it forward to simulate time passing. 2027-03-31 shows the whole feed.
FEED_AS_OF=2027-01-15

# Optional: read the feed from another folder (absolute, or relative to apps/web)
# FEED_DIR=../../regulatory-feed

# Optional: Database URL (if using a database for persistence)
# DATABASE_URL=file:./dev.db
