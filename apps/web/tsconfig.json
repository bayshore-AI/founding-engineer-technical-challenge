{
  "extends": "@repo/config-typescript/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/ui/*": [
        "../../pkgs/ui/src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    "../../pkgs/ui/src/**/*.ts",
    "../../pkgs/ui/src/**/*.tsx"
  ]
}
